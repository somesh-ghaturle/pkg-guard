{
  "name": "pkg-guard",
  "version": "0.4.2",
  "description": "Blocks installs of hallucinated, brand-new, unpopular, or typosquatted packages (npm, PyPI, crates, gems, Go)",
  "author": { "name": "Somesh Ghaturle" },
  "repository": "https://github.com/somesh-ghaturle/pkg-guard",
  "license": "MIT",
  "keywords": ["security", "supply-chain", "slopsquatting", "hooks"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/pkg_guard.py\" hook", "timeout": 20 }
        ]
      }
    ]
  }
}
