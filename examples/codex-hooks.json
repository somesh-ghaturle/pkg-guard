{
  "description": "pkg-guard: block hallucinated / typosquatted package installs",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          { "type": "command", "command": "pkg-guard hook", "timeout": 20, "statusMessage": "pkg-guard: checking packages" }
        ]
      }
    ]
  }
}
